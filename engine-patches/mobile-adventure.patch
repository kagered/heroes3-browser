+ int availableW=pos.w-176,availableH=pos.h-44;
+ auto picture=mobilePanel->add<MobilePuzzlePicture>(0,Rect(12,36,availableW,availableH),[this](Canvas & to){
+  // Translate the original map/masks into the same 591x544 source image.
+  Point shift=-mapView->pos.topLeft();
+  mapView->moveBy(shift);mapView->showAll(to);mapView->moveBy(-shift);
+  for(const auto & group:{visiblePieces,piecesToRemove})for(auto & piece:group){piece->moveBy(shift);piece->showAll(to);piece->moveBy(-shift);}
+ });
+
+ const std::array<Point,8> locations={Point(0,44),Point(96,44),Point(0,92),Point(96,92),Point(48,44),Point(48,140),Point(0,0),Point(48,92)};
+ for(int i=0;i<locations.size();++i){auto point=locations[i];
+  mobilePanel->add<PuzzleControl>(0,Rect(pos.w-152+point.x,point.y,i==6?140:44,i==6?36:44),i,i==6?mobileText("Вся карта","Whole map"):"",[picture,i](){
+   if(i==0)picture->camera.magnify(1.25);if(i==1)picture->camera.magnify(0.8);
+   if(i==2)picture->camera.pan(-64,0);if(i==3)picture->camera.pan(64,0);
+   if(i==4)picture->camera.pan(0,-64);if(i==5)picture->camera.pan(0,64);
+   if(i==6)picture->camera.overview=!picture->camera.overview;
+   if(i==7){picture->camera.center=Point(591/2,544/2);picture->camera.overview=false;}
+   picture->redraw();
+  });
+ }
+ mobilePanel->add<CMobileTownButton>(0,Rect(pos.w-152,pos.h-52,140,44),mobileText("Закрыть","Close"),[this](){close();});
+}
