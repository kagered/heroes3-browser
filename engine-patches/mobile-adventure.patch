+class CMobilePanel : public CIntObject
+{
+ std::shared_ptr<CFilledTexture> texture;
+ std::shared_ptr<CFilledTexture> screenBackground;
+ std::shared_ptr<CLabel> heading;
+ std::vector<std::shared_ptr<CMobileTownButton>> tabs;
+ std::shared_ptr<bool> resizeQueued=std::make_shared<bool>(false);
+public:
+ int current=0;
+ std::vector<std::shared_ptr<CIntObject>> pages;
+ std::vector<std::shared_ptr<CIntObject>> owned;
+ std::vector<std::function<void()>> refreshers;
+ std::vector<std::function<void(Canvas &)>> painters;
+ std::function<void(int)> onPage;
+ CMobilePanel(Point size,const std::string & title,const std::vector<std::string> & names,bool coverScreen=false)
+ {
+  OBJECT_CONSTRUCTION;
+  pos.w=size.x;pos.h=size.y;
+  // Full-page native windows repaint the margins as well as their panel. This
+  // removes old borders from the backing surface after viewport changes.
+  if(coverScreen)screenBackground=std::make_shared<CFilledTexture>(ImagePath::builtin("DiBoxBck"),Rect(-pos.x,-pos.y,GH.screenDimensions().x,GH.screenDimensions().y));
+  texture=std::make_shared<CFilledTexture>(ImagePath::builtin("DiBoxBck"),Rect(0,0,pos.w,pos.h));
+  heading=std::make_shared<CLabel>(16,18,FONT_MEDIUM,ETextAlignment::CENTERLEFT,Colors::YELLOW,title);
+  heading->setMaxWidth(pos.w-156);
+  for(size_t i=0;i<names.size();++i)pages.push_back(std::make_shared<CIntObject>());
+  if(names.empty())pages.push_back(std::make_shared<CIntObject>());
+  int width=names.empty()?0:(pos.w-24-8*(names.size()-1))/names.size();
+  for(int i=0;i<names.size();++i)tabs.push_back(std::make_shared<CMobileTownButton>(Rect(12+i*(width+8),pos.h-52,width,44),names[i],[this,i](){select(i);}));
+  select(0);
+ }
+ template<class T,class... Args> std::shared_ptr<T> add(int page,Args&&... args)
+ {
+  ObjectConstruction scope(page<0?this:pages.at(page).get());
+  auto object=std::make_shared<T>(std::forward<Args>(args)...);owned.push_back(object);return object;
+ }
+ template<class T> void adopt(int page,const std::shared_ptr<T> & object,Point local)
+ {
+  if(!object)return;
+  if(object->parent)object->parent->removeChild(object.get());
+  pages.at(page)->addChild(object.get());object->moveTo(pos.topLeft()+local);object->enable();
+ }
+ void select(int index)
+ {
+  current=index;
+  for(int i=0;i<pages.size();++i)pages[i]->setEnabled(i==index);
+  for(int i=0;i<tabs.size();++i)tabs[i]->setSelected(i==index);
+  if(onPage)onPage(index);
+  GH.windows().totalRedraw();
+ }
+ void showAll(Canvas & to) override
+ {
+  CIntObject::showAll(to);
+  for(auto & paint:painters)paint(to);
+  CMessage::drawBorder(LOCPLINT?LOCPLINT->playerID:PlayerColor(1),to,pos.w+28,pos.h+29,pos.x-14,pos.y-15);
+ }
+ void show(Canvas & to) override {for(auto & refresh:refreshers)refresh();CIntObject::show(to);showAll(to);}
+ void resize(const CIntObject * owner,std::function<void()> rebuild,int heightLimit=0)
+ {
+  if(owner!=GH.windows().topWindow<CIntObject>().get())return;
+  const Rect area=CMessage::mobileDialogArea();
+  if(*resizeQueued || area.w<=0 || (pos.w==std::min(780,area.w) && pos.h==(heightLimit?std::min(heightLimit,area.h):area.h)))return;
+  *resizeQueued=true;
+  std::weak_ptr<CIntObject> window=GH.windows().topWindow<CIntObject>();
+  auto queued=resizeQueued;
+  GH.dispatchMainThread([window,rebuild,queued](){*queued=false;if(auto live=window.lock();live && GH.windows().isTopWindow(live))rebuild();});
+ }
+};
+
+inline Rect prepareMobileWindow(CIntObject & owner,std::shared_ptr<CMobilePanel> & panel,int heightLimit=0,bool useScreenArea=false)
+{
+ const Rect area=useScreenArea?CMessage::mobileScreenArea():CMessage::mobileDialogArea();
+ if(area.w<500 || area.h<240)return Rect();
+ panel.reset();
+ owner.moveTo(Point(0,0));
+ for(auto child:owner.children)child->disable();
+ const int width=std::min(780,area.w);
+ const int height=heightLimit?std::min(heightLimit,area.h):area.h;
+ owner.pos=Rect(area.x+(area.w-width)/2,area.y+(area.h-height)/2,width,height);
+ return owner.pos;
+}
