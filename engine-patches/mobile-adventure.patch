+#pragma once
+#include "../../lib/Rect.h"
+#include <algorithm>
+#include <cmath>
+#include <utility>
+
+// A native image camera. Fill mode keeps original pixel size (or larger);
+// overview fits the whole source with preserved proportions.
+struct MobileImageCamera
+{
+ Point size;
+ Point center;
+ double zoom=1.0;
+ bool overview=false;
+ explicit MobileImageCamera(Point size):size(size),center(size.x/2,size.y/2){}
+ std::pair<Rect,Rect> frame(const Rect & bounds) const
+ {
+  if(overview){double scale=std::min(double(bounds.w)/size.x,double(bounds.h)/size.y);int w=std::max(1,int(size.x*scale)),h=std::max(1,int(size.y*scale));return {Rect(0,0,size.x,size.y),Rect(bounds.x+(bounds.w-w)/2,bounds.y+(bounds.h-h)/2,w,h)};}
+  double scale=std::max({zoom,double(bounds.w)/size.x,double(bounds.h)/size.y});
+  int w=std::clamp(int(bounds.w/scale),1,size.x),h=std::clamp(int(bounds.h/scale),1,size.y);
+  return {Rect(std::clamp(center.x-w/2,0,size.x-w),std::clamp(center.y-h/2,0,size.y-h),w,h),bounds};
+ }
+ void pan(int x,int y){overview=false;center=Point(std::clamp(center.x+x,0,size.x),std::clamp(center.y+y,0,size.y));}
+ void magnify(double factor){overview=false;zoom=std::clamp(zoom*factor,1.0,3.0);}
+};
