+void BattleWindow::setupMobile()
+{
+ const Rect area=CMessage::mobileScreenArea();
+ if(area.w<500 || area.h<240)return;
+ OBJECT_CONSTRUCTION;
+ if(!mobilePanel)moveTo(Point(0,0));
