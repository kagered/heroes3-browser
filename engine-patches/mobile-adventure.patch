 void CMessage::drawIWindow(CInfoWindow * ret, std::string text, PlayerColor player)
 {
+	const Rect mobileArea = mobileDialogArea();
+	if(mobileArea.w > 0)
+	{
+		int buttonHeight = ret->buttons.empty() ? 0 : 44;
+		int buttonWidth = 0;
+		for(const auto & button : ret->buttons)
+		{
+			int extra = std::max(0,44-button->pos.h);
+			for(auto * child : button->children) child->moveBy(Point(0,extra/2));
+			button->pos.h += extra;
+			buttonWidth += button->pos.w + 24;
+		}
+		if(buttonWidth) buttonWidth -= 24;
+		bool sideBySide = ret->components && mobileArea.w >= 460 && ret->components->pos.w + 240 <= mobileArea.w;
+		int width = std::min(mobileArea.w, sideBySide ? std::max(480,ret->components->pos.w+280) : 360);
+		width = std::max(width,buttonWidth+32);
+		int componentHeight = ret->components ? ret->components->pos.h : 0;
+		int textWidth = width-32-(sideBySide ? ret->components->pos.w+20 : 0);
+		int reserved = 32 + (buttonHeight ? buttonHeight+12 : 0) + (!sideBySide && componentHeight ? componentHeight+12 : 0);
+		int textBudget = std::max(32,mobileArea.h-reserved);
+		ret->text->resize(Point(textWidth,textBudget));
+		ret->text->trimToFit();
+		if(ret->buttons.empty() && !ret->components) width=std::min(width,ret->text->pos.w+32);
+		int contentHeight = sideBySide ? std::max(ret->text->pos.h,componentHeight) : ret->text->pos.h+(componentHeight ? componentHeight+12 : 0);
+		int height = std::min(mobileArea.h,32+contentHeight+(buttonHeight ? buttonHeight+12 : 0));
+		ret->pos = Rect(0,0,width,height);
+		ret->text->moveTo(Point(16,16+(sideBySide ? std::max(0,(contentHeight-ret->text->pos.h)/2) : 0)));
+		if(ret->text->slider) ret->text->slider->addUsedEvents(CIntObject::WHEEL | CIntObject::KEYBOARD);
+		if(ret->components)
+			ret->components->moveTo(sideBySide ? Point(width-16-ret->components->pos.w,16+std::max(0,(contentHeight-componentHeight)/2)) : Point((width-ret->components->pos.w)/2,28+ret->text->pos.h));
+		int x=(width-buttonWidth)/2;
+		for(const auto & button : ret->buttons)
+		{
+			button->moveTo(Point(x,height-16-buttonHeight));
+			x += button->pos.w+24;
+		}
+		ret->backgroundTexture->pos=ret->pos;
+		ret->moveTo(Point(mobileArea.x+(mobileArea.w-width)/2,mobileArea.y+(mobileArea.h-height)/2));
+		return;
+	}
