+Rect CMessage::mobileDialogArea()
+{
+#ifdef VCMI_HTML5_BUILD
+	if(!MAIN_THREAD_EM_ASM_INT({return Module.mobileAdventureUI ? 1 : 0;})) return Rect();
+	bool mapLayer = false;
+	for(const auto & window : GH.windows().findWindows<CIntObject>())
+	{
+		if(window.get() == adventureInt.get()) mapLayer = true;
+		else if(mapLayer)
+		{
+			auto level = std::dynamic_pointer_cast<CLevelWindow>(window);
+			if(!std::dynamic_pointer_cast<CInfoWindow>(window) && !window->isPopupWindow() && !(level && level->isMobileDialog())) mapLayer = false;
+		}
+	}
+	if(!mapLayer) return Rect();
+	int w = MAIN_THREAD_EM_ASM_INT({return Math.min(Module.mobileViewport.width,Math.max(innerWidth,innerHeight));});
+	int h = MAIN_THREAD_EM_ASM_INT({return Math.min(Module.mobileViewport.height,Math.min(innerWidth,innerHeight));});
+	return Rect(16,64,std::max(200,w-32),std::max(120,h-80));
+#else
+	return Rect();
+#endif
+}
