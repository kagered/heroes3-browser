+ CMobileTownPanorama(Rect rect,std::shared_ptr<CCastleBuildings> source):CIntObject(LCLICK|SHOW_POPUP|TIME),buildings(source),buffer(Point(source->pos.w,source->pos.h),CanvasScalingPolicy::AUTO)
+ {pos=rect+pos.topLeft();}
