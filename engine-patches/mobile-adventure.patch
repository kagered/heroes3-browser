+ if(!mobileBuffer)mobileBuffer=std::make_unique<Canvas>(Point(800,556),CanvasScalingPolicy::AUTO);
+ // Use all playable screen space below the browser-game toolbar, with no
+ // ornamental panel or side column. The whole original battlefield is visible.
+ mobileFieldBounds=Rect(0,48,area.w+32,area.h+32);
+ MobileImageCamera fullField(Point(800,556));fullField.overview=true;
