+ if(mobileGold->getText()!=gold)mobileGold->setText(gold);
+ const std::array<bool,4> enabled={true,town->hasBuilt(BuildingID::MARKETPLACE),town->hasBuilt(BuildingID::MAGES_GUILD_1),town->hasBuilt(BuildingID::TAVERN)};
+ for(int i=0;i<mobileActionButtons.size();++i)mobileActionButtons[i]->setAvailable(enabled[i]);
+ for(int i=0;i<mobileCreatureButtons.size();++i){std::string text=town->getTown()->creatures[i].back().toCreature()->getNamePluralTranslated()+"\n"+mobileTownText("Не построено","Not built");if(i<town->creatures.size() && !town->creatures[i].second.empty()){auto creature=town->creatures[i].second.back().toCreature();text=creature->getNamePluralTranslated()+"\n"+mobileTownText("Доступно: ","Available: ")+std::to_string(town->creatures[i].first);}mobileCreatureButtons[i]->setText(text);bool exists=i<town->creatures.size() && !town->creatures[i].second.empty();mobileCreatureButtons[i]->setAvailable(exists);if(exists)mobileCreatureButtons[i]->setCreatureIcon(town->creatures[i].second.back().toCreature()->getIconIndex());}
