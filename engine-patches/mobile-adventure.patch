+    if(value.find("_ID")!=std::string::npos)value.clear();
+    if(value.empty())value=std::to_string(group->getSelected());
+   }
+   entry.button->setText(entry.caption+(value.empty()?"":"\n"+value));
+   if(auto button=std::dynamic_pointer_cast<CButton>(entry.source))entry.button->setAvailable(!button->isBlocked());
+  }
+  CIntObject::show(to);
+ }
