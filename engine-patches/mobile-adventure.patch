+/* Nonblocking dialog completion gate. GPL v2.0 or later, as the VCMI client. */
+#pragma once
+#include <functional>
+#include <utility>
+
+class DeferredDialogCompletion
+{
+ std::function<void()> completion;
+public:
+ bool schedule(std::function<void()> next)
+ {
+  if(completion)return false;
+  completion=std::move(next);return true;
+ }
+ std::function<void()> takeReady(bool queueEmpty,bool dialogBusy)
+ {
+  if(!queueEmpty || dialogBusy)return {};
+  auto ready=std::move(completion);completion={};return ready;
+ }
+};
+
+// Campaign victories keep their original next-scenario flow. Campaign defeats,
+// like standalone completion, end the session and can use browser teardown.
+inline bool deferMobileScenarioCompletion(bool mobile,int humans,bool campaign,bool victory)
+{
+ return mobile && humans==1 && (!campaign || !victory);
+}
