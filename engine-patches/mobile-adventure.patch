+ CBuildingRect * hit(const Point & point){Point mapped((point.x-pos.x)*buildings->pos.w/pos.w,(point.y-pos.y)*buildings->pos.h/pos.h);for(auto it=buildings->children.rbegin();it!=buildings->children.rend();++it)if(auto b=dynamic_cast<CBuildingRect *>(*it);b && b->getBuilding() && b->receiveEvent(mapped,LCLICK))return b;return nullptr;}
+ void clickPressed(const Point & p) override {if(auto b=hit(p))buildings->buildingClicked(b->getBuilding()->bid);}
+ void showPopupWindow(const Point & p) override {if(auto b=hit(p))b->showPopupWindow(p);}
+};
