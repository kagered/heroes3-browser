+bool BattleWindow::mobileBattleFieldHit(const Point & p) const
+{
+ if(!mobilePanel || mobileMenuOpen || !mobileField.isInside(p))return false;
+ for(const auto & tile:mobileQuickTiles)if(tile->pos.isInside(p))return false;
+ return true;
+}
+Point BattleWindow::mobileInputPoint(const Point & p) const
+{
+ if(!mobilePanel)return p;
+ if(!mobileBattleFieldHit(p))return Point(-10000,-10000);
+ return Point(mobileSource.x+(p.x-mobileField.x)*mobileSource.w/mobileField.w,mobileSource.y+(p.y-mobileField.y)*mobileSource.h/mobileField.h);
+}
