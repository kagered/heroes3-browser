+void WindowHandler::retireGameWindowsForBrowserTeardown()
+{
+	// The browser never starts another game in this runtime after completion.
+	// Move popped windows out of per-frame disposal before publishing the results.
+	// In particular, do not run game-window destructors from renderFrame while
