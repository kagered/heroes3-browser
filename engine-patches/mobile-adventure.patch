+   if(e.button)e.button->moveTo(origin);
+   else
+   {
+    e.widgets[0]->moveTo(origin);
+    e.widgets[1]->moveTo(origin+Point(0,20));e.widgets[2]->moveTo(origin+Point(cw-60,20));e.widgets[3]->moveTo(origin+Point(cw/2,42));
