+class PuzzleControl : public CIntObject
+{
+ int glyph;
+ std::string text;
+ std::function<void()> action;
+public:
+ PuzzleControl(Rect rect,int glyph,const std::string & text,std::function<void()> action):CIntObject(LCLICK),glyph(glyph),text(text),action(action){pos=rect+pos.topLeft();}
+ void clickPressed(const Point &) override{auto run=action;run();}
+ void showAll(Canvas & to) override{
+  to.drawColorBlended(pos,ColorRGBA(20,22,25,205));to.drawBorder(pos,Colors::METALLIC_GOLD);
+  Point c=pos.center();auto line=[&](Point a,Point b){to.drawLine(a,b,Colors::WHITE,Colors::WHITE);to.drawLine(a+Point(1,0),b+Point(1,0),Colors::WHITE,Colors::WHITE);};
+  if(glyph==0 || glyph==1){line(c+Point(-8,0),c+Point(8,0));if(glyph==0)line(c+Point(0,-8),c+Point(0,8));}
+  if(glyph>=2 && glyph<=5){Point d=glyph==2?Point(-1,0):glyph==3?Point(1,0):glyph==4?Point(0,-1):Point(0,1);Point n(-d.y,d.x);line(c-d*8,c+d*8);line(c+d*8,c+n*6);line(c+d*8,c-n*6);}
+  if(glyph==7){to.drawBorder(Rect(c.x-6,c.y-6,12,12),Colors::WHITE);line(c+Point(-10,0),c+Point(10,0));line(c+Point(0,-10),c+Point(0,10));}
+  if(glyph==6)to.drawText(c,FONT_SMALL,Colors::WHITE,ETextAlignment::CENTER,text);
+ }
+ void show(Canvas & to) override{showAll(to);}
+};
