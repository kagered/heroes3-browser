+ mobilePanel=std::make_shared<CIntObject>();mobilePanel->pos=pos;
+ struct Command{const char *ru;const char *en;const char *image;EShortcut key;};
+ const std::vector<Command> primary={
+  {"Ждать","Wait","icm006",EShortcut::BATTLE_WAIT},
+  {"Защита","Defend","icm007",EShortcut::BATTLE_DEFEND},
+  {"Магия","Spells","icm005",EShortcut::BATTLE_CAST_SPELL}
+ };
+ auto addCommand=[this](CIntObject * parent,Rect rect,const Command & command,bool quick){
+  ObjectConstruction capture(parent);auto key=command.key;
+  auto tile=std::make_shared<BattleQuickTile>(rect,mobileText(command.ru,command.en),command.image,[this,key](){if(mobileMenuOpen)toggleMobileMenu();InterfaceObjectConfigurable::keyPressed(key);});
+  if(quick)mobileQuickTiles.push_back(tile);
+  mobileRefreshers.push_back([this,key,tile](){tile->setAvailable(!shortcutIsBlocked(key));});
+  return tile;
+ };
+ // Wide phones have spare side margins: use those before covering any image.
+ bool side=mobileFieldBounds.x+mobileFieldBounds.w-(mobileField.x+mobileField.w)>=72;
+ for(int i=0;i<3;++i){int x=side?mobileFieldBounds.w-68:mobileField.x+mobileField.w-4*64+4+i*64;
+  int y=side?mobileFieldBounds.y+std::max(4,(mobileFieldBounds.h-4*62)/2)+i*62:mobileField.y+4;
+  addCommand(mobilePanel.get(),Rect(x-pos.x,y-pos.y,60,56),primary[i],true);
+ }
+ {ObjectConstruction capture(mobilePanel.get());int x=side?mobileFieldBounds.w-68:mobileField.x+mobileField.w-60;
+  int y=side?mobileFieldBounds.y+std::max(4,(mobileFieldBounds.h-4*62)/2)+3*62:mobileField.y+4;
+  auto more=std::make_shared<BattleQuickTile>(Rect(x-pos.x,y-pos.y,60,56),mobileText("Ещё","More"),"icm003",[this](){toggleMobileMenu();});mobileQuickTiles.push_back(more);
+ }
+ const std::vector<Command> secondary={
+  {"Отряд","Unit","",EShortcut::BATTLE_OPEN_ACTIVE_UNIT},{"Автобой","Auto","icm004",EShortcut::BATTLE_AUTOCOMBAT},
+  {"Настройки","Options","icm003",EShortcut::GLOBAL_OPTIONS},{"Отступить","Retreat","icm002",EShortcut::BATTLE_RETREAT},
+  {"Сдаться","Surrender","icm001",EShortcut::BATTLE_SURRENDER},{"Действие","Action","",EShortcut::BATTLE_SELECT_ACTION},
+  {"Следующий","Next","",EShortcut::BATTLE_TACTICS_NEXT},{"Начать бой","Start","",EShortcut::BATTLE_TACTICS_END}
+ };
+ int mw=std::min(420,mobileFieldBounds.w-24),mh=std::min(254,mobileFieldBounds.h-16);
+ {ObjectConstruction capture(mobilePanel.get());mobileMenu=std::make_shared<BattleQuickMenu>(Rect((mobileFieldBounds.w-mw)/2-pos.x,mobileFieldBounds.y+(mobileFieldBounds.h-mh)/2-pos.y,mw,mh));}
+ int tw=(mw-32)/3,th=std::min(56,(mh-62)/3);
+ for(int i=0;i<secondary.size();++i)addCommand(mobileMenu.get(),Rect(8+(i%3)*(tw+8),8+(i/3)*(th+6),tw,th),secondary[i],false);
+ {ObjectConstruction capture(mobileMenu.get());auto close=std::make_shared<BattleQuickTile>(Rect(mw-100,mh-48,92,44),mobileText("Закрыть","Close"),"",[this](){toggleMobileMenu();});mobileRefreshers.push_back([close](){close->setAvailable(true);});}
+ mobileMenu->disable();
+ owner.fieldController->enable();
+ // BattleHero owns TIME events needed to finish spell animations; keep it active.
+}
+void BattleWindow::showMobile(Canvas & to)
+{
+ const auto area=CMessage::mobileScreenArea();
+ if(area.w!=pos.w || area.h!=pos.h){setupMobile();GH.windows().totalRedraw();}
+ for(auto child:children)if(child!=mobilePanel.get() && child!=owner.fieldController.get())child->disable();
+ // BattleHero owns TIME events needed to finish spell animations; keep it active.
+ to.drawColor(mobileFieldBounds,ColorRGBA(19,17,14,255));
+ static_cast<CIntObject *>(owner.fieldController.get())->show(*mobileBuffer);
+ if(settings["battle"]["showQueue"].Bool())queue->showAll(*mobileBuffer);
+ to.drawScaled(*mobileBuffer,mobileSource,mobileField);
+ for(auto & refresh:mobileRefreshers)refresh();
+ mobilePanel->showAll(to);
+}
