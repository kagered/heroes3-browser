+   if(auto toggle=std::dynamic_pointer_cast<CToggleButton>(entry.source))value=toggle->isSelected()?mobileText("Да","On"):mobileText("Нет","Off");
+   else if(auto group=std::dynamic_pointer_cast<CToggleGroup>(entry.source))
+   {
+    auto found=group->buttons.find(group->getSelected());if(found!=group->buttons.end())if(auto button=std::dynamic_pointer_cast<CButton>(found->second))value=button->mobileLabel();
+    if(entry.valueLabel)value=entry.valueLabel->getText();
