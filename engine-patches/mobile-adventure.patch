+void CCastleInterface::adaptMobileViewport()
+{
+ if(!mobileLayout || mobileResizeQueued)return;
+ const Rect area=CMessage::mobileDialogArea();
+ if(area.w<=0 || (pos.w==area.w+32 && pos.h==area.h+32))return;
+ mobileResizeQueued=true;
+ std::weak_ptr<CCastleInterface> owner=GH.windows().topWindow<CCastleInterface>();
+ GH.dispatchMainThread([owner]()
+ {
+  auto previous=owner.lock();
+  if(!previous)return;
+  if(!GH.windows().isTopWindow(previous)){previous->mobileResizeQueued=false;return;}
+  const auto town=previous->town;
+  const int page=previous->mobilePage;
+  previous->close();
+  auto replacement=std::make_shared<CCastleInterface>(town,town);
+  replacement->setMobilePage(page);
+  GH.windows().pushWindow(replacement);
+ });
+}
+
+void CCastleInterface::setMobilePage(int page)
+{
+ if(!mobileLayout)return;
+ mobilePage=page;
+ for(int i=0;i<mobilePages.size();++i)mobilePages[i]->setEnabled(i==page);
+ GH.windows().totalRedraw();
+}
